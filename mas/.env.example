# Copy to mas/.env and fill in. mas/.env is gitignored — never commit real keys.
# Full explanation of every variable: see README.md → "Choosing an LLM endpoint".

# ── LLM: pick a route ─────────────────────────────────────────────────────
# INTERNAL_LLM_BASE_URL set -> internal gateway.  Unset -> OpenRouter.
# Each route reads only its own variables, so both blocks can stay filled in.

# Route A — OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RM_COPILOT_MODEL=google/gemma-4-31b-it

# Route B — internal gateway (uncomment both to switch)
# INTERNAL_LLM_BASE_URL=https://your-gateway.internal/v1
# INTERNAL_LLM_API_KEY=<key for that gateway>
# INTERNAL_LLM_MODEL=default

# ── Optional ──────────────────────────────────────────────────────────────
# RM_COPILOT_SSL_CA_BUNDLE=/path/to/company-ca.pem   # private CA (Route B)
# RM_COPILOT_VERIFY_SSL=1                            # force TLS verification
# RM_COPILOT_MIN_INTERVAL=3.5                        # min seconds between calls
# RM_COPILOT_TRIM_CONTEXT=0                          # send full history (default 1 = trim)
# RM_COPILOT_CONTEXT_LIMIT=65536                     # override the gateway's context window
# RM_COPILOT_MAX_TOKENS=2048                         # cap output tokens (Route B default)

# MAS APIMG key — live SORA for the Market Rates panel. Unrelated to the LLM.
MAS_API_KEY=

# ── Issuing institution (all optional; unset = the neutral "The Bank" demo) ──
# Set these to adapt the system to a real policy corpus under mas/t&c/.
# RM_COPILOT_BANK_LEGAL_NAME=Sample Bank Limited  # collapsed at tokenization…
# RM_COPILOT_BANK_SHORT_NAME=SBL                   # …to this abbreviation
# RM_COPILOT_BANK_ALIASES=Sample Bank Limited,SBL  # letterhead the model may write
#                                                  # from memory; stripped from the body
